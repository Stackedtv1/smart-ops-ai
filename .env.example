# --- Front end (exposed to the browser; Vite reads VITE_*) ---
# auto = call Netlify AI functions, fall back to on-device demo classifier
# offline = never call external APIs (safe mode for flaky venue Wi-Fi)
VITE_AI_MODE=auto

# Optional: cross-device realtime (operator phone -> dashboard on the projector)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Netlify functions only (set in Netlify > Site settings > Environment) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1
